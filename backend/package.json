{
  "name": "i-rate-that-movie-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do I Rate That Movie",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --watch --watch-path=dist dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
